<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions, merged over src/main. See CaptureProbeReceiver. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- DUMP is held by adb shell and not grantable to third-party apps,
             so only a developer at the adb prompt can trigger the probe. -->
        <receiver
            android:name=".CaptureProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
